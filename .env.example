# ButterStudy 環境變數(範例檔 — 複製為 .env.local 並填入真實值,切勿提交)

# NVIDIA NIM API(https://build.nvidia.com/settings 產生)
NVIDIA_API_KEY=
# 選用:覆寫模型或端點
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Turso 資料庫(https://turso.tech 建立;本地開發未設定時改用 file:./data/local.db)
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

# 登入 session 簽名密鑰(任意長隨機字串,例如 openssl rand -base64 32)
AUTH_SECRET=